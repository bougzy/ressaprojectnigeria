# Copy this file to .env.local and fill in your values.

# MongoDB connection. If MONGODB_URI is not set, the app falls back to a
# built-in MongoDB Atlas connection string in src/lib/mongodb.js, so setting
# this on Vercel is optional. Set it here (or on Vercel) to override that
# default with your own database.
MONGODB_URI="mongodb+srv://stockpulse:stockpulse@stockpulse.k7rlq2w.mongodb.net/stockpulse"

# Admin login and session secret are hardcoded directly in src/lib/auth.js
# (username "admin", password "Ressa@2024") — they do NOT read from
# environment variables, intentionally, so the dashboard works the same
# everywhere without any Vercel env var setup. To change the password,
# edit src/lib/auth.js and redeploy. No ADMIN_USERNAME / ADMIN_PASSWORD /
# AUTH_SECRET env vars are needed (and setting them here or on Vercel now
# has no effect).

# Public WhatsApp number for chat/CTA buttons (no +)
NEXT_PUBLIC_WHATSAPP="2347043331195"
