# Copy this file to .env.local and fill in your values.

# MongoDB connection (local or MongoDB Atlas SRV string)
MONGODB_URI="mongodb://127.0.0.1:27017/ressa"

# Admin login (change before going live)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me"

# Long random string used to sign the admin session cookie
AUTH_SECRET="change-me-to-a-long-random-string"

# Public WhatsApp number for chat/CTA buttons (no +)
NEXT_PUBLIC_WHATSAPP="2347043331195"
